  <testCase>
    <class>Custom_Command</class>
    <desc>Trigger Reestablishment</desc>
    <node>localhost</node>
    <command>echo ci force_reestab | ncat 192.168.71.171 9090 | grep -E 'Reset RLC counters of UE RNTI [0-9a-f]{4} to trigger reestablishment'</command>
  </testCase>

  <testCase>
    <class>Ping</class>
